# Required. Postgres connection string.
#   Local:  postgres://postgres:<password>@localhost:5432/FanthomAI
#   Neon/Vercel Postgres: use the pooled connection string.
DATABASE_URL=

# Optional. When set, "Ask" answers are phrased by Claude from the retrieved
# transcript lines, and imported transcripts get Claude-written notes.
# Without it, the built-in retrieval engine and local analyzer are used.
ANTHROPIC_API_KEY=
